<aside class="drawer drawer-right drawer-lg rubrics-edit-panel" id="rubricFieldDrawer" role="dialog" aria-modal="true" aria-labelledby="rubricFieldTitle" hidden>
  <div class="drawer-header">
    <div>
      <h3 id="rubricFieldTitle">Новое поле</h3>
      <p class="text-secondary text-sm">Тип хранится в схеме рубрики; панель управления подбирает для него подходящий редактор.</p>
    </div>
    <button class="btn btn-ghost btn-icon" type="button" data-close-drawer aria-label="Закрыть"><i class="ti ti-x"></i></button>
  </div>
  <form id="rubricFieldForm" class="rubrics-drawer">
    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
    <input type="hidden" name="id" value="">
    <input type="hidden" name="rubric_id" value="">
    <div class="drawer-body rubrics-field-form">
      <section class="rubrics-field-section" style="--sec:var(--blue-600);--sec-soft:var(--blue-100)">
        <div class="rubrics-field-section-head">
          <span class="icon-tile" style="--tile-bg:var(--sec-soft);--tile-fg:var(--sec)"><i class="ti ti-forms"></i></span>
          <div><h4>Основное</h4><p>Название, алиас, тип и группа поля.</p></div>
        </div>
        <div class="rubrics-field-section-body">
          <div class="form-grid">
            <label class="field col-6"><span class="field-label">Название</span><input class="input" type="text" name="rubric_field_title" required><span class="field-error" data-error="rubric_field_title"></span></label>
            <label class="field col-6"><span class="field-label">Алиас</span><input class="input" type="text" name="rubric_field_alias" maxlength="20" autocomplete="off"><span class="field-hint" data-field-alias-state></span><span class="field-error" data-error="rubric_field_alias"></span></label>
            <label class="field col-6"><span class="field-label">Тип</span><select class="select" name="rubric_field_type">{% for type in field_types %}<option value="{{ type.id }}" data-field-type-option data-field-type-label="{{ type.name|e }}" data-enabled="{{ type.enabled ? '1' : '0' }}"{{ type.enabled ? '' : ' disabled' }}>{{ type.name }}{{ type.enabled ? '' : ' (отключён)' }}</option>{% endfor %}</select><span class="field-error" data-error="rubric_field_type"></span></label>
            <label class="field col-6"><span class="field-label">Группа</span><select class="select" name="rubric_field_group" data-field-groups-select><option value="0">Без группы</option></select></label>
          </div>
        </div>
      </section>

      <section class="rubrics-field-section rubrics-field-section-plugin" style="--sec:var(--cyan-600);--sec-soft:var(--cyan-100)" data-field-plugin-panel>
        <div class="rubrics-field-section-head">
          <span class="icon-tile" style="--tile-bg:var(--sec-soft);--tile-fg:var(--sec)"><i class="ti ti-plug-connected"></i></span>
          <div><h4>Редактор типа</h4><p>Настройки, зависящие от выбранного типа поля.</p></div>
        </div>
        <div class="rubrics-field-section-body">
          <div class="rubrics-plugin-body" data-field-plugin-body>
            <div class="empty-state">Выберите тип поля.</div>
          </div>
        </div>
      </section>

      <section class="rubrics-field-section" style="--sec:var(--amber-600);--sec-soft:var(--amber-100)">
        <div class="rubrics-field-section-head">
          <span class="icon-tile" style="--tile-bg:var(--sec-soft);--tile-fg:var(--sec)"><i class="ti ti-adjustments-alt"></i></span>
          <div><h4>Поведение</h4><p>Поиск, тип значения и значение по умолчанию.</p></div>
        </div>
        <div class="rubrics-field-section-body">
          <div class="form-grid">
            <label class="field col-6"><span class="field-label">Поиск</span><select class="select" name="rubric_field_search"><option value="1">Участвует в поиске</option><option value="0">Не индексировать</option></select></label>
            <label class="field col-6"><span class="field-label">Числовое</span><select class="select" name="rubric_field_numeric"><option value="0">Обычное значение</option><option value="1">Числовое значение</option></select></label>
            <label class="field col-12 rubrics-default-field">
              <span class="field-label" data-field-control-label="rubric_field_default">Значение по умолчанию</span>
              <textarea class="textarea" name="rubric_field_default" rows="4" data-field-default-storage></textarea>
              <div class="rubrics-default-editor" data-field-default-editor hidden></div>
              <span class="field-hint" data-field-control-hint="rubric_field_default"></span>
            </label>
            <label class="field col-12"><span class="field-label">Подсказка редактору (HTML)</span><textarea class="textarea mono" name="rubric_field_description" rows="4" placeholder="Например: <strong>Важно:</strong> укажите значение в сантиметрах."></textarea><span class="field-hint">Показывается под полем при редактировании документа. Можно использовать <code>&lt;strong&gt;</code>, <code>&lt;small&gt;</code>, <code>&lt;br&gt;</code>, ссылки и списки; опасный HTML удаляется.</span></label>
          </div>
        </div>
      </section>

      <section class="rubrics-field-section" style="--sec:var(--teal-600);--sec-soft:var(--teal-100)">
        <div class="rubrics-field-section-head">
          <span class="icon-tile" style="--tile-bg:var(--sec-soft);--tile-fg:var(--sec)"><i class="ti ti-layout-columns"></i></span>
          <div><h4>Оформление в документе</h4><p>Ширина в сетке и приставка/суффикс поля.</p></div>
        </div>
        <div class="rubrics-field-section-body">
          <div class="form-grid">
            <label class="field col-4"><span class="field-label">Ширина поля</span><select class="select" name="rubric_field_layout[width]"><option value="">Авто</option><option value="full">Полная</option><option value="half">Половина</option><option value="third">Треть</option><option value="quarter">Четверть</option></select><span class="field-hint">Узкие поля встают в колонки.</span></label>
            <label class="field col-4"><span class="field-label">Приставка</span><input class="input" type="text" name="rubric_field_layout[prefix]" maxlength="12" autocomplete="off"><span class="field-hint">Слева, напр. №, $.</span></label>
            <label class="field col-4"><span class="field-label">Суффикс</span><input class="input" type="text" name="rubric_field_layout[suffix]" maxlength="12" autocomplete="off"><span class="field-hint">Справа, напр. ₽, кг, %.</span></label>
          </div>
          <p class="field-hint" style="margin-top:2px">Обязательность настраивается в «Редакторе типа» → Валидация.</p>
        </div>
      </section>

      <section class="rubrics-field-section" style="--sec:var(--violet-600);--sec-soft:var(--violet-100)">
        <div class="rubrics-field-section-head">
          <span class="icon-tile" style="--tile-bg:var(--sec-soft);--tile-fg:var(--sec)"><i class="ti ti-code"></i></span>
          <div><h4>Шаблоны вывода</h4><p>HTML-шаблоны отображения поля и request.</p></div>
        </div>
        <div class="rubrics-field-section-body">
          <div class="rubrics-tag-legend" data-tag-legend>
            <div class="rubrics-tag-legend-head"><i class="ti ti-brackets-contain"></i><b>Доступные теги</b><small>клик — вставить в активный редактор</small></div>
            <div class="rubrics-tag-legend-list">
              <button type="button" class="rubrics-tag-chip" data-field-tpl-tag="[tag:value]"><code>[tag:value]</code><span>значение поля целиком</span></button>
              <button type="button" class="rubrics-tag-chip" data-field-tpl-tag="[tag:parametr:0]"><code>[tag:parametr:N]</code><span>часть значения №N (по «|»)</span></button>
              <button type="button" class="rubrics-tag-chip" data-field-tpl-tag="[tag:label]"><code>[tag:label]</code><span>название поля</span></button>
              <button type="button" class="rubrics-tag-chip" data-field-tpl-tag="[tag:default]"><code>[tag:default]</code><span>значение по умолчанию</span></button>
              <button type="button" class="rubrics-tag-chip" data-field-tpl-tag="[tag:alias]"><code>[tag:alias]</code><span>алиас поля</span></button>
              <button type="button" class="rubrics-tag-chip" data-field-tpl-tag="[tag:img:[tag:value]]"><code>[tag:img:/путь]</code><span>&lt;img&gt; из пути (можно [tag:value])</span></button>
              <button type="button" class="rubrics-tag-chip" data-field-tpl-tag="[tag:if_notempty][tag:value][tag:else]—[/tag:if_notempty]"><code>[tag:if_notempty]…[tag:else]…[/tag:if_notempty]</code><span>если поле заполнено</span></button>
              <button type="button" class="rubrics-tag-chip" data-field-tpl-tag="[tag:if_empty]—[/tag:if_empty]"><code>[tag:if_empty]…[/tag:if_empty]</code><span>если поле пустое</span></button>
              <button type="button" class="rubrics-tag-chip" data-field-tpl-tag="[tag:c200x100:[tag:value]]"><code>[tag:c200x100:/путь]</code><span>миниатюра: c-обрезка/r-ресайз/f-вписать</span></button>
            </div>
          </div>
          <div class="form-grid">
            {{ ui.code_field('Шаблон вывода', 'rubric_field_template', 180, 'col-12') }}
            {{ ui.code_field('Шаблон request', 'rubric_field_template_request', 180, 'col-12') }}
          </div>
        </div>
      </section>
    </div>
    <div class="drawer-footer">
      <button class="btn btn-ghost" type="button" data-close-drawer><i class="ti ti-x"></i>Закрыть</button>
      <button class="btn btn-primary" type="submit"><i class="ti ti-device-floppy"></i>Сохранить</button>
    </div>
  </form>
</aside>

<aside class="drawer drawer-right rubrics-revisions-panel" id="rubricSchemaRevisionsDrawer" role="dialog" aria-modal="true" aria-labelledby="rubricSchemaRevisionsTitle" hidden>
  <div class="drawer-header">
    <div>
      <h3 id="rubricSchemaRevisionsTitle">Ревизии схемы рубрики</h3>
      <p class="text-secondary text-sm" data-schema-revisions-subtitle>История полей, групп, раскладки и условий формы.</p>
    </div>
    <button class="btn btn-ghost btn-icon" type="button" data-close-drawer aria-label="Закрыть"><i class="ti ti-x"></i></button>
  </div>
  <div class="drawer-body rubrics-revisions-body">
    <section class="rubrics-revisions-section" aria-label="Снимки схемы">
      <div class="rubrics-revisions-head">
        <span class="icon-tile" style="--tile-bg:var(--cyan-100);--tile-fg:var(--cyan-600)"><i class="ti ti-history"></i></span>
        <div><h4>Снимки схемы</h4><p class="text-secondary" data-schema-revisions-count>Загрузка...</p></div>
      </div>
      <div class="rubrics-revisions-list" data-schema-revisions-list>
        <div class="empty-state">Загрузка...</div>
      </div>
    </section>

    <section class="rubrics-revisions-section rubrics-revision-preview" aria-label="Последствия восстановления">
      <div class="rubrics-revisions-head">
        <span class="icon-tile" style="--tile-bg:var(--violet-100);--tile-fg:var(--violet-600)"><i class="ti ti-restore"></i></span>
        <div><h4 data-schema-revision-title>Выберите ревизию</h4><p class="text-secondary" data-schema-revision-meta>Здесь появится точный список изменений до восстановления.</p></div>
      </div>
      <div class="rubrics-revision-preview-body" data-schema-revision-preview>
        <div class="rubrics-revision-empty"><i class="ti ti-history"></i><b>Снимок не выбран</b><span>Выберите запись в истории выше.</span></div>
      </div>
    </section>
  </div>
  <div class="drawer-footer">
    <button class="btn btn-ghost" type="button" data-close-drawer><i class="ti ti-x"></i>Закрыть</button>
    <button class="btn btn-danger-soft" type="button" data-schema-revisions-clear disabled><i class="ti ti-trash"></i>Удалить все</button>
    <button class="btn btn-secondary" type="button" data-schema-revision-delete disabled style="margin-left:auto"><i class="ti ti-trash"></i>Удалить снимок</button>
    <button class="btn btn-primary" type="button" data-schema-revision-restore disabled><i class="ti ti-restore"></i>Восстановить</button>
  </div>
</aside>

<aside class="drawer drawer-right rubrics-revisions-panel" id="rubricTrashDrawer" role="dialog" aria-modal="true" aria-labelledby="rubricTrashTitle" hidden>
  <div class="drawer-header">
    <div>
      <h3 id="rubricTrashTitle">Корзина рубрик</h3>
      <p class="text-secondary text-sm">Удалённые рубрики со всей схемой. Можно восстановить или удалить окончательно.</p>
    </div>
    <button class="btn btn-ghost btn-icon" type="button" data-close-drawer aria-label="Закрыть"><i class="ti ti-x"></i></button>
  </div>
  <div class="drawer-body rubrics-revisions-body">
    <section class="rubrics-revisions-section" aria-label="Удалённые рубрики">
      <div class="rubrics-revisions-head">
        <span class="icon-tile" style="--tile-bg:var(--red-100);--tile-fg:var(--red-600)"><i class="ti ti-trash"></i></span>
        <div><h4>Удалённые рубрики</h4><p class="text-secondary" data-rubric-trash-count>Загрузка...</p></div>
      </div>
      <div class="rubrics-revisions-list" data-rubric-trash-list>
        <div class="empty-state">Загрузка...</div>
      </div>
    </section>
  </div>
  <div class="drawer-footer">
    <button class="btn btn-ghost" type="button" data-close-drawer><i class="ti ti-x"></i>Закрыть</button>
  </div>
</aside>

<aside class="drawer drawer-right drawer-lg rubrics-group-panel" id="rubricGroupDrawer" role="dialog" aria-modal="true" aria-labelledby="rubricGroupTitle" hidden>
  <div class="drawer-header">
    <div>
      <h3 id="rubricGroupTitle">Новая группа</h3>
      <p class="text-secondary text-sm">Группа полей внутри рубрики.</p>
    </div>
    <button class="btn btn-ghost btn-icon" type="button" data-close-drawer aria-label="Закрыть"><i class="ti ti-x"></i></button>
  </div>
  <form id="rubricGroupForm" class="rubrics-drawer">
    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
    <input type="hidden" name="id" value="">
    <input type="hidden" name="rubric_id" value="">
    <input type="hidden" name="group_condition" value="{}">
    <div class="drawer-body">
      <div class="form-grid">
        <label class="field col-12"><span class="field-label">Название</span><input class="input" type="text" name="group_title" required><span class="field-error" data-error="group_title"></span></label>
        <label class="field col-12"><span class="field-label">Описание</span><textarea class="textarea" name="group_description" rows="5"></textarea></label>
        <div class="col-12">
          <section class="rubrics-builder-condition rubrics-group-condition" data-builder-condition data-condition-scope="group">
            <div class="rubrics-builder-condition-head">
              <span class="icon-tile" style="--tile-bg:var(--cyan-100);--tile-fg:var(--cyan-700)"><i class="ti ti-adjustments-horizontal"></i></span>
              <span><b>Условие для всей группы</b><small>Можно скрыть группу или запретить изменение всех её полей.</small></span>
              <label class="switch"><input type="checkbox" data-builder-condition-enabled aria-label="Включить условие группы"></label>
            </div>
            <div class="rubrics-builder-condition-body" data-builder-condition-body hidden>
              <div class="form-grid">
                <label class="field col-12"><span class="field-label">Что делать при совпадении</span><select class="select" data-builder-condition-mode><option value="show">Показывать группу</option><option value="hide">Скрывать группу</option><option value="lock">Запретить изменение</option></select></label>
              </div>
              <div class="rubrics-builder-condition-rows" data-builder-condition-rows></div>
            </div>
          </section>
        </div>
      </div>
    </div>
    <div class="drawer-footer">
      <button class="btn btn-ghost" type="button" data-close-drawer><i class="ti ti-x"></i>Закрыть</button>
      <button class="btn btn-primary" type="submit"><i class="ti ti-device-floppy"></i>Сохранить</button>
    </div>
  </form>
</aside>
{% endif %}

{% endblock %}
