{% extends '@adminx/main.twig' %}
{% block title %}Рубрики и поля{% endblock %}

{% macro code_field(label, name, height, extra, tags) %}
<div class="field rubrics-code-field{{ extra ? ' ' ~ extra : '' }}">
  <span class="field-label rubrics-code-label">
    <span>{{ label }}</span>
    <span class="rubrics-code-tools">
      {% if tags %}<button class="btn btn-ghost btn-icon btn-sm rubrics-template-tags-button" type="button" data-rubric-template-tags-toggle data-tooltip="Теги" aria-label="Теги"><i class="ti ti-brackets-contain"></i></button>{% endif %}
      <button class="btn btn-ghost btn-icon btn-sm rubrics-lint-button" type="button" data-rubric-code-lint data-tooltip="Проверить PHP" aria-label="Проверить PHP"><i class="ti ti-bug"></i></button>
      <button class="btn btn-ghost btn-icon btn-sm rubrics-code-fullscreen-button" type="button" data-rubric-code-fullscreen data-tooltip="Развернуть редактор" aria-label="Развернуть редактор"><i class="ti ti-arrows-maximize"></i></button>
    </span>
  </span>
  <textarea class="textarea mono" name="{{ name }}" data-code-editor data-mode="php" data-height="{{ height }}"></textarea>
  <span class="field-hint rubrics-code-lint-result" data-rubric-code-lint-result></span>
</div>
{% endmacro %}

{% block content %}
{% import _self as ui %}

<nav class="breadcrumbs" aria-label="Хлебные крошки">
  <a href="{{ ADMINX_BASE }}/">Главная</a><i class="ti ti-chevron-right"></i>
  <span>Рубрики и поля</span>
</nav>

<div class="page-header">
  <div class="between">
    <div>
      <h1>Рубрики и поля</h1>
      <p class="text-secondary" style="margin-top:5px">Типы материалов, их поля и оформление.</p>
    </div>
    <div class="cluster">
      {% if can_manage %}
      <button class="btn btn-secondary" type="button" data-rubric-trash-open><i class="ti ti-trash"></i>Корзина{% if trash_count %} <span class="badge badge-gray" data-rubric-trash-badge>{{ trash_count }}</span>{% endif %}</button>
      <button class="btn btn-primary" type="button" data-rubric-new data-open-drawer="rubricDrawer"><i class="ti ti-plus"></i>Создать рубрику</button>
      {% endif %}
    </div>
  </div>
</div>

<div class="rubrics-summary">
  <div class="card rubrics-stat">
    <span class="icon-tile" style="--tile-bg:var(--blue-100);--tile-fg:var(--blue-600)"><i class="ti ti-forms"></i></span>
    <div><b>{{ stats.rubrics }}</b><span>Рубрик</span></div>
  </div>
  <div class="card rubrics-stat">
    <span class="icon-tile" style="--tile-bg:var(--green-100);--tile-fg:var(--green-600)"><i class="ti ti-circle-check"></i></span>
    <div><b>{{ stats.active }}</b><span>Активных</span></div>
  </div>
  <div class="card rubrics-stat">
    <span class="icon-tile" style="--tile-bg:var(--cyan-100);--tile-fg:var(--cyan-600)"><i class="ti ti-input-search"></i></span>
    <div><b>{{ stats.fields }}</b><span>Полей</span></div>
  </div>
  <div class="card rubrics-stat">
    <span class="icon-tile" style="--tile-bg:var(--violet-100);--tile-fg:var(--violet-600)"><i class="ti ti-folders"></i></span>
    <div><b>{{ stats.groups }}</b><span>Групп</span></div>
  </div>
</div>

{% set content_model_section = active_tab %}
{% set content_model_interactive = true %}
{% include '@rubrics/_content_tabs.twig' %}

<section class="rubrics-panel" data-rubrics-main-panel="rubrics"{{ active_tab == 'rubrics' ? '' : ' hidden' }}>
  <div class="section-header rubrics-panel-header">
    <div class="section-icon"><i class="ti ti-forms"></i></div>
    <div>
      <div class="section-eyebrow">Контент</div>
      <h2>Структура документов</h2>
      <p class="section-desc">Настройте состав формы, затем сразу переходите к материалам выбранной рубрики.</p>
    </div>
  </div>

  <div class="card rubrics-card rubrics-filter-card">
    <div class="rubrics-section-head">
      <div class="rubrics-section-title">
        <span class="icon-tile rubrics-head-icon" style="--tile-bg:var(--cyan-100);--tile-fg:var(--cyan-600)"><i class="ti ti-table"></i></span>
        <div>
          <h2>Рубрики</h2>
          <p class="text-secondary">{{ rubrics|length }} в текущем фильтре, {{ stats.rubrics }} всего.</p>
        </div>
      </div>
      <span class="badge badge-blue">{{ filters.state ? filters.state : 'all' }}</span>
    </div>
    <div class="table-toolbar rubrics-toolbar">
      <form class="rubrics-filter" method="get" action="{{ ADMINX_BASE }}/rubrics">
        <div class="input-wrap">
          <i class="ti ti-search"></i>
          <input class="input" type="search" name="q" value="{{ filters.q }}" placeholder="ID, название, алиас или описание">
        </div>
        <select class="select" name="state">
          <option value="">Все состояния</option>
          <option value="active"{{ filters.state == 'active' ? ' selected' : '' }}>Активные</option>
          <option value="inactive"{{ filters.state == 'inactive' ? ' selected' : '' }}>Отключённые</option>
          <option value="meta"{{ filters.state == 'meta' ? ' selected' : '' }}>Авто meta</option>
        </select>
        <button class="btn btn-secondary" type="submit"><i class="ti ti-filter"></i>Показать</button>
        {% if filters.q or filters.state %}
        <button class="btn btn-ghost" type="button" data-rubrics-filter-reset><i class="ti ti-x"></i>Сбросить</button>
        {% endif %}
      </form>
    </div>
  </div>

  <div class="card rubrics-card">
    <div class="rubrics-section-head">
      <div class="rubrics-section-title">
        <span class="icon-tile rubrics-head-icon" style="--tile-bg:var(--violet-100);--tile-fg:var(--violet-600)"><i class="ti ti-list-details"></i></span>
        <div>
          <h2>Список рубрик</h2>
          <p class="text-secondary">{{ can_manage ? 'Перетащите строки за ручку, чтобы изменить порядок.' : 'Просмотр структуры рубрик.' }}</p>
        </div>
      </div>
      <span class="badge badge-blue">{{ rubrics|length }}</span>
    </div>
    <div class="table-scroll">
      <table class="table table-compact rubrics-table">
        <colgroup>
          {% if can_manage %}<col class="rubrics-col-handle">{% endif %}
          <col class="rubrics-col-id">
          <col class="rubrics-col-title">
          <col class="rubrics-col-state">
          <col class="rubrics-col-counts">
          <col class="rubrics-col-documents">
          <col class="rubrics-col-meta">
          {% if can_manage %}<col class="rubrics-col-actions">{% endif %}
        </colgroup>
        <thead>
          <tr>
            {% if can_manage %}<th class="rubrics-cell-handle"></th>{% endif %}
            <th class="rubrics-cell-id">ID</th>
            <th class="rubrics-cell-title">Название</th>
            <th class="rubrics-cell-state">Состояние</th>
            <th class="rubrics-cell-counts">Состав</th>
            <th class="rubrics-cell-documents">Материалы</th>
            <th class="rubrics-cell-template">Шаблон</th>
            {% if can_manage %}<th class="rubrics-cell-actions"></th>{% endif %}
          </tr>
        </thead>
        <tbody{% if can_manage %} data-rubrics-sortable{% endif %}>
          {% for rubric in rubrics %}
          <tr data-rubric-row
              data-id="{{ rubric.Id }}"
              data-title="{{ rubric.rubric_title|e('html_attr') }}"
              data-alias="{{ rubric.rubric_alias|e('html_attr') }}">
            {% if can_manage %}
            <td class="rubrics-cell-handle"><button class="btn btn-ghost btn-icon btn-sm rubrics-drag-handle" type="button" draggable="true" data-rubric-drag-handle data-tooltip-right="Перетащить" aria-label="Перетащить"><i class="ti ti-grip-vertical"></i></button></td>
            {% endif %}
            <td class="mono text-muted rubrics-cell-id">{{ rubric.Id }}</td>
            <td class="rubrics-cell-title">
              <div class="rubrics-name">
                <b>{{ rubric.rubric_title }}</b>
                <small>{{ rubric.rubric_alias ? rubric.rubric_alias : 'без алиаса' }}</small>
              </div>
            </td>
            <td class="rubrics-cell-state">
              <div class="rubrics-badges">
                {% if rubric.rubric_docs_active == 1 %}<span class="badge badge-green">активна</span>{% else %}<span class="badge badge-gray">выкл</span>{% endif %}
                {% if rubric.rubric_meta_gen == '1' %}<span class="badge badge-cyan">meta</span>{% endif %}
                {% if rubric.rubric_alias_history == '1' %}<span class="badge badge-violet">history</span>{% endif %}
				{% if rubric.rubric_purpose == 'directory' %}<span class="badge badge-cyan">справочник</span>{% endif %}
				{% if rubric.rubric_is_technical %}<span class="badge badge-gray"><i class="ti ti-tool"></i> служебная</span>{% endif %}
                {% if rubric.Id == 1 %}<span class="badge badge-amber">system</span>{% endif %}
              </div>
            </td>
            <td class="rubrics-cell-counts">
              <div class="rubrics-meta">
                <span>{{ rubric.fields_count }} полей</span>
                <span>{{ rubric.templates_count }} доп. шаблонов</span>
              </div>
            </td>
            <td class="rubrics-cell-documents">
              <div class="rubrics-materials">
                {% if can_view_documents %}
                <a class="rubrics-materials-link" href="{{ ADMINX_BASE }}/documents?rubric_id={{ rubric.Id }}" data-tooltip="Открыть материалы рубрики">
                  <span><b>{{ rubric.docs_count }}</b><small>{{ rubric.docs_count == 1 ? 'документ' : (rubric.docs_count in [2,3,4] ? 'документа' : 'документов') }}</small></span><i class="ti ti-arrow-right"></i>
                </a>
                {% else %}
                <span class="rubrics-materials-count"><b>{{ rubric.docs_count }}</b><small>документов</small></span>
                {% endif %}
                {% if can_manage_documents %}<a class="btn btn-ghost btn-icon btn-sm rubrics-action-document-new" href="{{ ADMINX_BASE }}/documents/create?rubric_id={{ rubric.Id }}" data-tooltip="Создать материал" aria-label="Создать материал в рубрике {{ rubric.rubric_title|e('html_attr') }}"><i class="ti ti-file-plus"></i></a>{% endif %}
              </div>
            </td>
            <td class="rubrics-cell-template">
              <div class="rubrics-template-name{{ rubric.site_template_title ? '' : ' is-missing' }}">
                <b>{{ rubric.site_template_title ?: 'Не выбран' }}</b>
                {% if rubric.rubric_template_id %}<small class="mono">#{{ rubric.rubric_template_id }}</small>{% endif %}
              </div>
            </td>
            {% if can_manage %}
            <td class="rubrics-cell-actions">
              <div class="cluster rubrics-actions">
                <button class="btn btn-ghost btn-icon btn-sm rubrics-action-fields" type="button" data-rubric-fields data-open-drawer="rubricFieldsDrawer" data-tooltip="Поля" aria-label="Поля"><i class="ti ti-input-search"></i></button>
                <button class="btn btn-ghost btn-icon btn-sm rubrics-action-templates" type="button" data-rubric-templates data-open-drawer="rubricTemplatesDrawer" data-tooltip="Шаблоны" aria-label="Шаблоны"><i class="ti ti-template"></i></button>
                <button class="btn btn-ghost btn-icon btn-sm rubrics-action-admin-view" type="button" data-rubric-admin-view data-open-drawer="rubricAdminViewDrawer" data-tooltip="Вид документов" aria-label="Вид документов"><i class="ti ti-layout-cards"></i></button>
                <button class="btn btn-ghost btn-icon btn-sm rubrics-action-revisions" type="button" data-rubric-schema-revisions data-tooltip="Ревизии схемы" aria-label="Ревизии схемы"><i class="ti ti-history"></i></button>
                <button class="btn btn-ghost btn-icon btn-sm rubrics-action-edit" type="button" data-rubric-edit data-open-drawer="rubricDrawer" data-tooltip="Изменить" aria-label="Изменить"><i class="ti ti-pencil"></i></button>
                {% if rubric.can_delete %}
                <button class="btn btn-ghost btn-icon btn-sm rubrics-action-danger" type="button" data-rubric-delete data-tooltip="Удалить" aria-label="Удалить"><i class="ti ti-trash"></i></button>
                {% else %}
                <button class="btn btn-ghost btn-icon btn-sm rubrics-action-locked" type="button" disabled data-tooltip="Удаление недоступно" aria-label="Удаление недоступно"><i class="ti ti-lock"></i></button>
                {% endif %}
              </div>
            </td>
            {% endif %}
          </tr>
          {% else %}
          <tr><td colspan="{{ can_manage ? 8 : 6 }}"><div class="empty-state">Рубрики не найдены.</div></td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="rubrics-panel rubrics-types-panel" data-rubrics-main-panel="types"{{ active_tab == 'types' ? '' : ' hidden' }}>
  <div class="section-header rubrics-panel-header">
    <div class="section-icon"><i class="ti ti-plug-connected"></i></div>
    <div>
      <div class="section-eyebrow">Поля рубрик</div>
      <h2>Типы полей</h2>
      <p class="section-desc">Настройте рабочий набор для новых рубрик. Отключение не влияет на уже созданные поля.</p>
    </div>
  </div>

  <div class="rubrics-type-summary">
    <div class="card rubrics-stat">
      <span class="icon-tile" style="--tile-bg:var(--green-100);--tile-fg:var(--green-600)"><i class="ti ti-toggle-right"></i></span>
      <div><b data-field-types-enabled>{{ field_type_summary.enabled }}</b><span>Включено</span></div>
    </div>
    <div class="card rubrics-stat">
      <span class="icon-tile" style="--tile-bg:var(--gray-100);--tile-fg:var(--gray-600)"><i class="ti ti-toggle-left"></i></span>
      <div><b data-field-types-disabled>{{ field_type_summary.disabled }}</b><span>Отключено</span></div>
    </div>
    <div class="card rubrics-stat">
      <span class="icon-tile" style="--tile-bg:var(--red-100);--tile-fg:var(--red-600)"><i class="ti ti-circle-x"></i></span>
      <div><b>{{ field_type_summary.error }}</b><span>Ошибок реестра</span></div>
    </div>
    <div class="card rubrics-stat">
      <span class="icon-tile" style="--tile-bg:var(--cyan-100);--tile-fg:var(--cyan-600)"><i class="ti ti-database"></i></span>
      <div><b>{{ field_type_summary.used }}</b><span>Полей в БД</span></div>
    </div>
  </div>

  <div class="card rubrics-card">
    <div class="rubrics-section-head">
      <div class="rubrics-section-title">
        <span class="icon-tile rubrics-head-icon" style="--tile-bg:var(--violet-100);--tile-fg:var(--violet-600)"><i class="ti ti-list-check"></i></span>
        <div>
          <h2>Доступные типы полей</h2>
          <p class="text-secondary">Выберите, какие поля будут доступны при настройке рубрик.</p>
        </div>
      </div>
      <span class="badge badge-blue"><span data-field-types-enabled>{{ field_type_summary.enabled }}</span> / {{ field_types|length }}</span>
    </div>
    <div class="rubrics-type-tools">
      <div class="input-wrap"><i class="ti ti-search"></i><input class="input" type="search" placeholder="Название, код или назначение" data-field-types-search></div>
      <select class="select" data-field-types-state aria-label="Состояние типов полей">
        <option value="">Все типы</option>
        <option value="enabled">Включённые</option>
        <option value="disabled">Отключённые</option>
        <option value="used">Используемые</option>
        <option value="new">Новые типы</option>
      </select>
    </div>
    <div class="table-scroll">
      <table class="table table-compact rubrics-type-table">
        <colgroup>
          <col class="rubrics-type-col-name">
          <col class="rubrics-type-col-description">
          <col class="rubrics-type-col-usage">
          <col class="rubrics-type-col-status">
          <col class="rubrics-type-col-enabled">
        </colgroup>
        <thead>
          <tr>
            <th>Тип</th>
            <th>Описание</th>
            <th>Использование</th>
            <th>Состояние</th>
            <th>Выбор</th>
          </tr>
        </thead>
        <tbody>
          {% for type in field_types %}
          <tr class="{{ type.enabled ? '' : 'is-disabled' }}" data-field-type-row data-type="{{ type.id }}" data-state="{{ type.enabled ? 'enabled' : 'disabled' }}" data-new="{{ type.is_new ? '1' : '0' }}" data-usage="{{ field_type_usage[type.id]|default(0) }}" data-search="{{ (type.name ~ ' ' ~ type.id ~ ' ' ~ type.description)|lower|e }}">
            <td>
              <div class="rubrics-type-name">
                <div class="rubrics-type-title"><b>{{ type.name }}</b>{% if type.is_new %}<span class="badge badge-cyan">Новый</span>{% endif %}</div>
                <small class="mono">{{ type.id }}</small>
              </div>
            </td>
            <td><p class="rubrics-type-description">{{ type.description }}</p></td>
            <td><span class="badge badge-blue">{{ field_type_usage[type.id]|default(0) }} полей</span></td>
            <td>
              {% if type.status == 'ok' %}
                <span class="badge badge-green">готов</span>
              {% elseif type.status == 'error' %}
                <span class="badge badge-red">ошибка</span>
              {% else %}
                <span class="badge badge-amber">проверить</span>
              {% endif %}
              {% if type.issues %}
              <div class="rubrics-type-issues">
                {% for issue in type.issues|slice(0, 2) %}<span>{{ issue }}</span>{% endfor %}
              </div>
              {% endif %}
            </td>
            <td>
              {% if can_manage %}
              <label class="switch rubrics-type-switch" data-tooltip="{{ type.enabled ? 'Убрать из выбора новых полей' : 'Добавить в выбор новых полей' }}">
                <input type="checkbox" data-field-type-toggle="{{ type.id }}"{{ type.enabled ? ' checked' : '' }} aria-label="{{ type.enabled ? 'Отключить' : 'Включить' }} тип {{ type.name }}"><span></span>
              </label>
              {% else %}
              <span class="badge {{ type.enabled ? 'badge-green' : 'badge-gray' }}" data-field-type-state-label>{{ type.enabled ? 'Включён' : 'Отключён' }}</span>
              {% endif %}
            </td>
          </tr>
          {% else %}
          <tr><td colspan="5"><div class="empty-state">Типы полей не найдены.</div></td></tr>
          {% endfor %}
          <tr data-field-types-empty hidden><td colspan="5"><div class="empty-state">По выбранным условиям типы не найдены.</div></td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

{% if can_manage %}
<aside class="drawer drawer-right drawer-lg rubrics-drawer-panel" id="rubricDrawer" role="dialog" aria-modal="true" aria-labelledby="rubricDrawerTitle" hidden>
  <div class="drawer-header">
    <div>
      <h3 id="rubricDrawerTitle">Новая рубрика</h3>
      <p class="text-secondary text-sm" data-rubric-drawer-subtitle>Базовые параметры рубрики.</p>
    </div>
    <button class="btn btn-ghost btn-icon" type="button" data-close-drawer aria-label="Закрыть"><i class="ti ti-x"></i></button>
  </div>
  <form id="rubricForm" class="rubrics-drawer" data-base="{{ ADMINX_BASE }}">
    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
    <input type="hidden" name="id" value="">
    <div class="drawer-body rubrics-field-form">
      <section class="rubrics-field-section" style="--sec:var(--blue-600);--sec-soft:var(--blue-100)">
        <div class="rubrics-field-section-head">
          <span class="icon-tile" style="--tile-bg:var(--sec-soft);--tile-fg:var(--sec)"><i class="ti ti-folder"></i></span>
          <div><h4>Основное</h4><p>Название, URL-алиас и описание рубрики.</p></div>
        </div>
        <div class="rubrics-field-section-body">
          <div class="form-grid">
            <label class="field col-6"><span class="field-label">Название</span><input class="input" type="text" name="rubric_title" required><span class="field-error" data-error="rubric_title"></span></label>
            <label class="field col-6"><span class="field-label">Шаблон URL документов</span><input class="input mono" type="text" name="rubric_alias" autocomplete="off" placeholder="news/%d-%m-%Y"><span class="field-hint" data-rubric-alias-state></span><span class="field-error" data-error="rubric_alias"></span></label>
            <div class="col-12 rubrics-alias-help-grid">
              <div class="alert alert-info rubrics-alias-help">
                <i class="ti ti-calendar-code alert-ic"></i>
                <div><b class="alert-title">Как составить шаблон</b><span>Обычные части пути пишутся напрямую. Маркеры даты берутся из даты публикации документа.</span><div class="rubrics-alias-token-list">{% for token, description in rubric_alias_tokens %}<code>{{ token }}</code><span>{{ description }}</span>{% endfor %}</div></div>
              </div>
              <div class="alert alert-info rubrics-alias-help">
                <i class="ti ti-route alert-ic"></i>
                <div><b class="alert-title">Как формируется адрес</b><span>К развёрнутому шаблону добавляется alias документа. Пустой шаблон оставляет документ в корне.</span><code class="rubrics-alias-preview" data-rubric-alias-preview>/document-alias</code><small>Изменение шаблона не переписывает URL уже созданных документов.</small></div>
              </div>
            </div>
            <label class="field col-12"><span class="field-label">Описание</span><textarea class="textarea" name="rubric_description" rows="5"></textarea></label>
            <label class="field col-6">
              <span class="field-label">Назначение</span>
              <select class="select" name="rubric_purpose">
                <option value="content">Контент</option>
                <option value="directory">Справочник на документах (старый формат)</option>
              </select>
              <span class="field-hint">Для обычных списков используйте вкладку «Справочники». Старый формат оставлен только для совместимости.</span>
            </label>
            <label class="field col-12" data-rubric-preset-wrap>
              <span class="field-label">Стартовый набор полей</span>
              <select class="select" name="rubric_preset" data-rubric-preset>
                <option value="" data-description="Рубрика будет создана без дополнительных полей.">Пустая рубрика</option>
                {% for preset in field_presets %}
                <option value="{{ preset.code }}" data-description="{{ preset.description|e('html_attr') }}"{{ preset.available ? '' : ' disabled' }}>{{ preset.title }} · {{ preset.field_count }} полей{% if not preset.available %} · включите {{ preset.missing_types|join(', ') }}{% endif %}</option>
                {% endfor %}
              </select>
