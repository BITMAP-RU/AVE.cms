            <label class="field"><span class="field-label">Подпись</span><input class="input" type="text" maxlength="80" data-admin-view-label></label>
            <label class="field"><span class="field-label">Формат</span><select class="select" data-admin-view-format><option value="text">Текст</option><option value="badge">Метка</option><option value="number">Число</option><option value="date">Дата</option><option value="image">Изображение</option></select></label>
            <fieldset class="rubrics-admin-view-widths"><legend>Ширина</legend><label><input type="radio" name="admin_view_width" value="small"><span>Узкая</span></label><label><input type="radio" name="admin_view_width" value="medium"><span>Средняя</span></label><label><input type="radio" name="admin_view_width" value="wide"><span>Широкая</span></label></fieldset>
            <div class="rubrics-admin-view-field-meta" data-admin-view-field-meta></div>
          </div>
        </aside>
      </div>
    </div>

    <div class="drawer-footer">
      <button class="btn btn-ghost" type="button" data-close-drawer><i class="ti ti-x"></i>Закрыть</button>
      <a class="btn btn-secondary" href="{{ ADMINX_BASE }}/documents" data-admin-view-documents><i class="ti ti-external-link"></i>Открыть документы</a>
      <button class="btn btn-primary" type="submit"><i class="ti ti-device-floppy"></i>Сохранить представление</button>
    </div>
  </form>
</aside>

<aside class="drawer drawer-right drawer-lg rubrics-templates-panel" id="rubricTemplatesDrawer" role="dialog" aria-modal="true" aria-labelledby="rubricTemplatesTitle" hidden>
  <div class="drawer-header">
    <div>
      <h3 id="rubricTemplatesTitle">Шаблоны рубрики</h3>
