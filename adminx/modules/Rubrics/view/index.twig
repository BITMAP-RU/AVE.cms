          <button class="tab" type="button" role="tab" aria-selected="false" data-rubric-template-tab="teasers"><i class="ti ti-layout-list"></i>Анонсы</button>
          <button class="tab" type="button" role="tab" aria-selected="false" data-rubric-template-tab="og"><i class="ti ti-share-3"></i>Open Graph</button>
          <button class="tab" type="button" role="tab" aria-selected="false" data-rubric-template-tab="extra"><i class="ti ti-copy-plus"></i>Дополнительные<span class="tab-count" data-extra-template-count>0</span></button>
        </div>

