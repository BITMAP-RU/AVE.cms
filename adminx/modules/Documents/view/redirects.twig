{% extends '@adminx/main.twig' %}
{% block title %}Редиректы документов{% endblock %}
{% block content %}
<div data-redirects-content>
  <nav class="breadcrumbs" aria-label="Хлебные крошки"><a href="{{ ADMINX_BASE }}/">Главная</a><i class="ti ti-chevron-right"></i><a href="{{ ADMINX_BASE }}/documents">Документы</a><i class="ti ti-chevron-right"></i><span>Редиректы</span></nav>
  <div class="page-header"><div class="between"><div><h1>Редиректы документов</h1><p class="text-secondary" style="margin-top:5px">Старые адреса и документы, на которые они перенаправляют.</p></div>{% if can_manage %}<button class="btn btn-primary" type="button" data-redirect-create><i class="ti ti-plus"></i>Добавить редирект</button>{% endif %}</div></div>

  <div class="tabs documents-page-tabs" role="tablist" aria-label="Разделы документов">
    <a class="tab" href="{{ ADMINX_BASE }}/documents"><i class="ti ti-files"></i>Документы</a>
    <a class="tab" href="{{ ADMINX_BASE }}/documents/views"><i class="ti ti-chart-line"></i>Просмотры</a>
    <a class="tab is-active" href="{{ ADMINX_BASE }}/documents/redirects"><i class="ti ti-route"></i>Редиректы</a>
    <a class="tab" href="{{ ADMINX_BASE }}/documents/api"><i class="ti ti-api"></i>JSON API</a>
  </div>

  <div class="documents-summary">
    <div class="card documents-stat"><span class="icon-tile" style="--tile-bg:var(--cyan-100);--tile-fg:var(--cyan-600)"><i class="ti ti-route"></i></span><div><b>{{ stats.total }}</b><span>Всего редиректов</span></div></div>
    <div class="card documents-stat"><span class="icon-tile" style="--tile-bg:var(--blue-100);--tile-fg:var(--blue-600)"><i class="ti ti-files"></i></span><div><b>{{ stats.documents }}</b><span>Документов</span></div></div>
    <div class="card documents-stat"><span class="icon-tile" style="--tile-bg:var(--green-100);--tile-fg:var(--green-600)"><i class="ti ti-link"></i></span><div><b>{{ stats.permanent }}</b><span>Постоянных</span></div></div>
    <div class="card documents-stat"><span class="icon-tile" style="--tile-bg:var(--amber-100);--tile-fg:var(--amber-600)"><i class="ti ti-clock"></i></span><div><b>{{ stats.temporary }}</b><span>Временных</span></div></div>
  </div>

  <section class="documents-panel redirects-panel">
    <input type="hidden" value="{{ csrf_token }}" data-redirect-csrf>
    <div class="section-header documents-panel-header"><div class="section-icon"><i class="ti ti-route"></i></div><div><div class="section-eyebrow">Маршрутизация</div><h2>История адресов</h2><p class="section-desc">Каждый старый URL должен вести на существующий документ.</p></div></div>
    <div class="card documents-card documents-filter-card">
      <div class="documents-section-head"><div class="documents-section-title"><span class="icon-tile documents-head-icon" style="--tile-bg:var(--cyan-100);--tile-fg:var(--cyan-600)"><i class="ti ti-filter"></i></span><div><h2>Фильтры</h2><p class="text-secondary">{{ pagination.from }}-{{ pagination.to }} из {{ pagination.total }}</p></div></div></div>
      <div class="table-toolbar documents-toolbar"><form class="documents-filter" method="get" action="{{ ADMINX_BASE }}/documents/redirects" data-redirect-filter><div class="input-wrap"><i class="ti ti-search"></i><input class="input" type="search" name="q" value="{{ filters.q }}" placeholder="Старый URL, документ или ID"></div><select class="select" name="header"><option value="0">Все коды</option>{% for code in [301,302,307,308] %}<option value="{{ code }}"{{ filters.header == code ? ' selected' : '' }}>{{ code }}</option>{% endfor %}</select><button class="btn btn-secondary" type="submit"><i class="ti ti-filter"></i>Показать</button>{% if filters.q or filters.header %}<button class="btn btn-ghost" type="button" data-redirect-filter-reset><i class="ti ti-x"></i>Сбросить</button>{% endif %}</form></div>
    </div>
    <div class="card documents-card">
      <div class="documents-section-head"><div class="documents-section-title"><span class="icon-tile documents-head-icon" style="--tile-bg:var(--violet-100);--tile-fg:var(--violet-600)"><i class="ti ti-list-details"></i></span><div><h2>Редиректы</h2><p class="text-secondary">Старый адрес, код ответа и текущая цель.</p></div></div><span class="badge badge-blue">{{ redirects|length }}</span></div>
      <div class="table-scroll"><table class="table table-compact redirects-table"><thead><tr><th>Старый URL</th><th>Код</th><th>Документ назначения</th><th>Изменён</th>{% if can_manage %}<th></th>{% endif %}</tr></thead><tbody>{% for item in redirects %}<tr class="redirects-row" data-redirect-row data-id="{{ item.id }}" data-document-id="{{ item.document_id }}" data-alias="{{ item.alias|e('html_attr') }}" data-header="{{ item.header }}" data-document-title="{{ item.document_title|e('html_attr') }}"><td class="redirects-cell-url"><div class="redirects-url"><a class="mono" href="/{{ item.alias }}" target="_blank" rel="noopener">/{{ item.alias }}</a><button class="btn btn-ghost btn-icon btn-xs" type="button" data-copy="/{{ item.alias }}" data-tooltip="Скопировать URL" aria-label="Скопировать URL"><i class="ti ti-copy"></i></button></div></td><td class="redirects-cell-code"><span class="badge badge-{{ item.header in [301,308] ? 'green' : 'amber' }}">{{ item.header }}</span></td><td class="redirects-cell-target"><div class="documents-name"><a href="{{ ADMINX_BASE }}/documents/{{ item.document_id }}/edit"><b>#{{ item.document_id }} · {{ item.document_title }}</b></a><small><i class="ti ti-arrow-right"></i>/{{ item.target_alias ?: 'без alias' }}{% if item.document_deleted %} · удалён{% endif %}</small></div></td><td class="redirects-cell-date"><div class="documents-meta"><span>{{ item.changed_label }}</span><span>{{ item.author_name ?: '#' ~ item.author_id }}</span></div></td>{% if can_manage %}<td class="redirects-cell-actions"><div class="cluster documents-actions"><button class="btn btn-ghost btn-icon btn-sm documents-action-edit" type="button" data-redirect-edit data-tooltip="Изменить" aria-label="Изменить"><i class="ti ti-pencil"></i></button><button class="btn btn-ghost btn-icon btn-sm documents-action-danger" type="button" data-redirect-delete data-tooltip="Удалить" aria-label="Удалить"><i class="ti ti-trash"></i></button></div></td>{% endif %}</tr>{% else %}<tr class="redirects-empty-row"><td colspan="{{ can_manage ? 5 : 4 }}"><div class="empty-state">Редиректы не найдены.</div></td></tr>{% endfor %}</tbody></table></div>
      <div class="documents-pagination"><span class="text-secondary">{{ pagination.from }}-{{ pagination.to }} из {{ pagination.total }}</span>{% if pagination.pages > 1 %}{% set current = pagination.page %}{% set pages = pagination.pages %}{% set page_url = ADMINX_BASE ~ '/documents/redirects?q=' ~ filters.q|url_encode ~ '&header=' ~ filters.header ~ '&page=' %}<nav class="pagination" aria-label="Страницы редиректов">{% if current > 1 %}<a class="page-link" data-redirect-page href="{{ page_url ~ (current - 1) }}" aria-label="Предыдущая страница"><i class="ti ti-chevron-left"></i></a>{% endif %}{% for page in 1..pages %}{% if page == 1 or page == pages or (page >= current - 2 and page <= current + 2) %}<a class="page-link {{ page == current ? 'active' : '' }}" data-redirect-page href="{{ page_url ~ page }}"{{ page == current ? ' aria-current="page"' : '' }}>{{ page }}</a>{% elseif (page == 2 and current > 4) or (page == pages - 1 and current < pages - 3) %}<span class="page gap" aria-hidden="true">…</span>{% endif %}{% endfor %}{% if current < pages %}<a class="page-link" data-redirect-page href="{{ page_url ~ (current + 1) }}" aria-label="Следующая страница"><i class="ti ti-chevron-right"></i></a>{% endif %}</nav>{% endif %}</div>
    </div>
  </section>

  {% if can_manage %}<aside class="drawer drawer-right drawer-lg" id="redirectDrawer" role="dialog" aria-modal="true" aria-labelledby="redirectDrawerTitle" hidden><div class="drawer-header"><div><h3 id="redirectDrawerTitle" data-redirect-title>Новый редирект</h3><p class="text-secondary text-sm" data-redirect-subtitle>Старый адрес документа.</p></div><button class="btn btn-ghost btn-icon" type="button" data-close-drawer aria-label="Закрыть"><i class="ti ti-x"></i></button></div><form class="drawer-form" data-redirect-form><div class="drawer-body"><input type="hidden" name="id" value="0"><div class="form-grid"><div class="field col-12"><span class="field-label">Документ назначения</span><input type="hidden" name="document_id" required><button class="documents-relation-choice" type="button" data-redirect-document-pick><i class="ti ti-file-text documents-relation-choice-ic"></i><span class="documents-relation-choice-text"><b data-redirect-document-title>Документ не выбран</b><small data-redirect-document-meta>Нажмите, чтобы найти документ</small></span><i class="ti ti-selector documents-relation-choice-caret"></i></button><span class="field-hint">Редирект будет вести на текущий URL выбранного документа.</span></div><label class="field col-9"><span class="field-label">Старый URL</span><div class="input-group"><span class="input-addon mono">/</span><input class="input mono" type="text" name="alias" required></div></label><label class="field col-3"><span class="field-label">Код</span><select class="select" name="header">{% for code in [301,302,307,308] %}<option value="{{ code }}">{{ code }}</option>{% endfor %}</select></label></div></div><div class="drawer-footer"><div class="df-left"><button class="btn btn-ghost" type="button" data-close-drawer>Закрыть</button></div><button class="btn btn-primary" type="submit"><i class="ti ti-device-floppy"></i>Сохранить</button></div></form></aside>{% endif %}
</div>
{% endblock %}
